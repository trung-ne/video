{
  "name": "cat-explainer-video",
  "version": "1.0.0",
  "description": "AI-powered 2D explainer video system",
  "scripts": {
    "start": "remotion studio src/index.ts",
    "preview": "remotion studio src/index.ts",
    "preview:project": "npx ts-node scripts/preview-project.ts",
    "render": "npx ts-node scripts/render.ts",
    "publish": "npx ts-node scripts/publish.ts",
    "accept-render": "npx ts-node scripts/accept-render.ts",
    "generate": "npx ts-node scripts/generate-timeline.ts",
    "build-storyboard": "npx ts-node scripts/build-storyboard.ts",
    "storyboard-to-tts": "npx ts-node scripts/storyboard-to-tts.ts",
    "compile-storyboard": "npx ts-node scripts/compile-storyboard.ts",
    "validate": "npx ts-node scripts/validate.ts",
    "quality": "npx ts-node scripts/quality-check.ts",
    "visual-audit": "python scripts/visual-audit.py",
    "reference-audit": "python scripts/reference-audit.py",
    "list-assets": "npx ts-node scripts/list-assets.ts",
    "build-assets": "npx ts-node scripts/build-asset-manifest.ts",
    "audit-assets": "python scripts/measure-asset-visuals.py public",
    "asset-status": "npx ts-node scripts/asset-status.ts",
    "typecheck": "npx tsc --noEmit",
    "test": "npx ts-node scripts/test.ts",
    "check": "npm run typecheck && npm test && python -m unittest scripts/test_align_words.py scripts/test_tts_fidelity.py scripts/test_visual_audit.py"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.56.0",
    "@google/genai": "^2.10.0",
    "@google/generative-ai": "^0.24.1",
    "@remotion/cli": "^4.0.248",
    "@remotion/player": "^4.0.248",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "^4.0.248"
  },
  "devDependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@types/node": "^20.0.0",
    "@types/react": "18.3.1",
    "@types/react-dom": "18.3.1",
    "fluent-ffmpeg": "^2.1.3",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0"
  }
}
