{
  "name": "cat-explainer-video",
  "version": "1.0.0",
  "description": "AI-powered 2D explainer video system",
  "scripts": {
    "start": "remotion studio src/index.ts",
    "preview": "remotion studio src/index.ts",
    "preview:project": "npx ts-node scripts/preview-project.ts",
    "render": "npx ts-node scripts/render.ts",
    "publish": "npx ts-node scripts/publish.ts",
    "generate": "npx ts-node scripts/generate-timeline.ts",
    "validate": "npx ts-node -e \"const {validateTimeline,printValidationResult}=require('./src/ai/validateTimeline');const fs=require('fs');const tl=JSON.parse(fs.readFileSync(process.argv[2]||'timeline.json','utf-8'));printValidationResult(validateTimeline(tl),process.argv[2]||'timeline.json');\"",
    "quality": "npx ts-node scripts/quality-check.ts",
    "visual-audit": "python scripts/visual-audit.py",
    "list-assets": "npx ts-node scripts/list-assets.ts",
    "build-assets": "npx ts-node scripts/build-asset-manifest.ts",
    "asset-status": "npx ts-node scripts/asset-status.ts",
    "typecheck": "npx tsc --noEmit",
    "test": "npx ts-node scripts/test.ts",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.56.0",
    "@google/genai": "^2.10.0",
    "@google/generative-ai": "^0.24.1",
    "@remotion/cli": "^4.0.248",
    "@remotion/player": "^4.0.248",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "^4.0.248"
  },
  "devDependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@types/node": "^20.0.0",
    "@types/react": "18.3.1",
    "@types/react-dom": "18.3.1",
    "fluent-ffmpeg": "^2.1.3",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0"
  }
}
